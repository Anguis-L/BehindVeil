{
  "name": "behindveil",
  "version": "0.0.0",
  "private": true,
  "description": "BehindVeil — self-hosted TRPG platform where an AI plays the Keeper",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --stream build",
    "typecheck": "pnpm -r --stream typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "check:licenses": "node scripts/check-licenses.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm check:licenses"
  },
  "devDependencies": {
    "@behindveil/shared": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.11",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
